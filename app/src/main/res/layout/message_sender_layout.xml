<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="4dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="8dp"
        android:background="@color/primary"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary2">

            <TextView
                android:id="@+id/timestamp"
                style="@style/primaryTextStyleOnBackground"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:gravity="center"
                android:text="14.44"
                android:textSize="12dp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                app:layout_constraintBottom_toTopOf="@id/senderMessage"
                app:layout_constraintEnd_toStartOf="@id/senderDelivered"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/senderDelivered"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginHorizontal="8dp"
                android:gravity="right"
                android:paddingTop="2dp"
                android:paddingBottom="1dp"
                android:src="@drawable/outline_arrows_more_up_24"
                app:layout_constraintBottom_toTopOf="@id/senderMessage"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/timestamp"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/senderMessage"
                style="@style/primaryTextStyleOnBackground"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="4dp"
                android:width="0dp"
                android:text="TextViewTextViewTextViewTextViewTextViewTextViewTextViewTextView"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/timestamp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>