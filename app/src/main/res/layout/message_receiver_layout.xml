<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/receiverProfilePicture"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircularImageViewStyle" />

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="48dp"
        android:background="@color/primary"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/receiverProfilePicture"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary">

            <TextView
                android:id="@+id/receiverNickname"
                style="@style/primaryTextStyleOnBackground"
                android:layout_height="wrap_content"
                android:width="0dp"
                android:textStyle="bold"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="4dp"
                android:text="John Doe"
                app:layout_constraintBottom_toTopOf="@id/messageReceiver"
                app:layout_constraintEnd_toStartOf="@id/timestampReceiver"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/timestampReceiver"
                style="@style/primaryTextStyleOnBackground"
                android:layout_height="0dp"
                android:layout_width="wrap_content"
                android:textSize="12dp"
                android:text="14.44"
                android:gravity="center"
                android:textStyle="bold"
                android:alpha="0.8"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintBottom_toTopOf="@id/messageReceiver"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/receiverNickname" />


            <TextView
                android:id="@+id/messageReceiver"
                style="@style/primaryTextStyleOnBackground"
                android:layout_height="wrap_content"
                android:width="0dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="4dp"
                android:text="TextViewTextViewTextViewTextViewTextViewTextViewTextViewTextView"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/receiverNickname" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>