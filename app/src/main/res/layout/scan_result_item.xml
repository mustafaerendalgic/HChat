<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/device_icon_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/scan_primary"
            android:padding="10dp"
            app:shapeAppearanceOverlay="@style/CircularImageViewStyle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:srcCompat="@drawable/baseline_smartphone_24"
            app:tint="@color/white"/>

        <TextView
            android:id="@+id/tv_host_name"
            style="@style/primaryTextStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Host: Unknown Device"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/scan_primary"
            app:layout_constraintStart_toEndOf="@id/device_icon_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_ip_address"
            style="@style/primaryTextStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:text="IP: 192.168.1.1"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@id/device_icon_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_host_name" />

        <TextView
            android:id="@+id/tv_mac_address"
            style="@style/primaryTextStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:text="MAC: 00:11:22:33:44:55"
            android:textSize="13sp"
            android:alpha="0.7"
            app:layout_constraintStart_toEndOf="@id/device_icon_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_ip_address" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
