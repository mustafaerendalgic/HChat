<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="64dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/b_profile_photo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@color/primary"
        android:padding="8dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/CircularImageViewStyle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/b_device_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/baseline_smartphone_24"
        android:padding="18dp"
        app:layout_constraintStart_toStartOf="@+id/b_profile_photo"
        app:layout_constraintEnd_toEndOf="@id/b_profile_photo"
        app:layout_constraintTop_toTopOf="@id/b_profile_photo"
        app:layout_constraintBottom_toBottomOf="@id/b_profile_photo"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/b_profile_photo"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.5" />

        <TextView
            android:id="@+id/b_username"
            style="@style/primaryTextStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="start"
            android:text="John Doe"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/guide"
            app:layout_constraintEnd_toStartOf="@+id/bluetooth_chat_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/b_last_message"
            style="@style/primaryTextStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.5"
            android:gravity="start"
            android:text="Say hi to John Doe!"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bluetooth_chat_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guide" />


        <TextView
            android:id="@+id/b_last_message_date"
            style="@style/primaryTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="1.5dp"
            android:alpha="0.5"
            android:gravity="center"
            android:textSize="12.5sp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guide" />

        <ImageView
            android:id="@+id/bluetooth_chat_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/baseline_chat_bubble_outline_24" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>