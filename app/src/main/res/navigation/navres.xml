<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navres"
    app:startDestination="@id/mainMenu">

    <fragment
        android:id="@+id/mainPage"
        android:name="com.example.chatapp.fragments.internet.InternetMainPage"
        android:label="fragment_main_page"
        tools:layout="@layout/i_fragment_main_page" >
        <action
            android:id="@+id/mainToChat"
            app:destination="@id/chatPage" />
        <action
            android:id="@+id/mainToLogin"
            app:destination="@id/loginPage" />
    </fragment>
    <fragment
        android:id="@+id/loginPage"
        android:name="com.example.chatapp.fragments.internet.LoginPage"
        android:label="fragment_login_page"
        tools:layout="@layout/fragment_login_page" >
        <action
            android:id="@+id/loginToMain"
            app:destination="@id/mainPage"
            app:popUpTo="@id/loginPage"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/loginToSign"
            app:destination="@id/signUpPage" />
    </fragment>
    <fragment
        android:id="@+id/chatPage"
        android:name="com.example.chatapp.fragments.internet.InternetChatPage"
        android:label="fragment_chat_page"
        tools:layout="@layout/i_fragment_chat_page" >
        <action
            android:id="@+id/chatToMain"
            app:destination="@id/mainPage" />
        <action
            android:id="@+id/chatToLogin"
            app:destination="@id/loginPage" />
    </fragment>
    <fragment
        android:id="@+id/signUpPage"
        android:name="com.example.chatapp.fragments.internet.SignUpPage"
        android:label="fragment_sign_up_page"
        tools:layout="@layout/fragment_sign_up_page" >
        <action
            android:id="@+id/signToLogin"
            app:destination="@id/loginPage"
            app:popUpTo="@id/signUpPage"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/signToMain"
            app:destination="@id/mainPage" />
    </fragment>
    <fragment
        android:id="@+id/mainMenu"
        android:name="com.example.chatapp.fragments.main.MainMenu"
        android:label="fragment_main_menu"
        tools:layout="@layout/fragment_main_menu" >
        <action
            android:id="@+id/main_to_i"
            app:destination="@id/loginPage" />
        <action
            android:id="@+id/main_to_b"
            app:destination="@id/bluetoothMainPage" />
    </fragment>
    <fragment
        android:id="@+id/bluetoothMainPage"
        android:name="com.example.chatapp.fragments.bluetooth.BluetoothMainPage"
        android:label="b_fragment_main_page"
        tools:layout="@layout/b_fragment_main_page" >
        <action
            android:id="@+id/b_main_to_chat"
            app:destination="@id/bluetoothChatPage" />
    </fragment>
    <fragment
        android:id="@+id/bluetoothChatPage"
        android:name="com.example.chatapp.fragments.bluetooth.BluetoothChatPage"
        android:label="b_fragment_chat_page"
        tools:layout="@layout/b_fragment_chat_page" />
</navigation>